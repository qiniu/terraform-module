#!/usr/bin/env bash
# prepare script (large-file chunking preamble, issue #58)
# staging root and target parent must be root-owned, non-symlink, realpath;
# existing target may only be overwritten when marker+SHA match (managed file);
# reuse existing staging only when marker matches exactly (clear old parts), otherwise refuse.
set -e
R=${staging_root}
D=${staging_dir}
T='${target_path}'
TD=$(dirname "$T")
mkdir -p "$R"
[ -d "$R" ]||exit 1
[ "$(stat -c %U "$R")" = root ]||exit 1
[ ! -L "$R" ]||exit 1
[ "$(realpath -m "$R")" = "$R" ]||exit 1
[ -d "$TD" ]||exit 1
[ "$(stat -c %U "$TD")" = root ]||exit 1
[ ! -L "$TD" ]||exit 1
[ "$(realpath -m "$TD")" = "$TD" ]||exit 1
${cover_guard}
if [ -e "$D" ]; then
  [ -d "$D" ]||exit 1
  [ "$(stat -c %U "$D")" = root ]||exit 1
  [ ! -L "$D" ]||exit 1
  [ "$(realpath -m "$D")" = "$D" ]||exit 1
  [ -f "$D/marker" ]||exit 1
  [ "$(cat "$D/marker")" = '${marker_content}' ]||exit 1
  rm -f "$D"/part.*
else
  mkdir -p "$D"
  printf '%s' '${marker_content}' > "$D/marker"
fi