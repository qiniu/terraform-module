#!/usr/bin/env bash
# destroy cleanup script (issue #58)
# delete managed file and staging ONLY when marker content and target SHA match exactly;
# otherwise treat as unmanaged and do nothing.
set -e
D=${staging_dir}
T='${target_path}'
if [ -f "$D/marker" ] && [ "$(cat "$D/marker")" = '${marker_content}' ]; then
  if [ -f "$T" ]; then
    if printf '%s  %s\n' '${content_sha256}' "$T" | sha256sum -c - >/dev/null 2>&1; then
      rm -f "$T"
    fi
  fi
  rm -rf "$D"
fi