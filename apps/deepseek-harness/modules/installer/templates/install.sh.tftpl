#!/usr/bin/env bash
set -euo pipefail
umask 077

install_failure() {
  failure_status="$?"
  trap - ERR
  restore_code_server || true
  systemctl status deepseek-harness.service --no-pager || true
  journalctl -u deepseek-harness.service -n 100 --no-pager || true
  systemctl status code-server.service --no-pager || true
  journalctl -u code-server.service -n 100 --no-pager || true
  systemctl status nginx --no-pager || true
  journalctl -u nginx -n 100 --no-pager || true
  exit "$failure_status"
}
trap install_failure ERR

retry() {
  max_attempts="$1"
  shift
  attempt=1
  until "$@"; do
    if [ "$attempt" -ge "$max_attempts" ]; then
      echo "command failed after $${max_attempts} attempts" >&2
      return 1
    fi
    sleep "$attempt"
    attempt=$((attempt + 1))
  done
}

restore_code_server() {
  [ "$${code_server_changed:-false}" = true ] || return 0
  systemctl stop code-server.service >/dev/null 2>&1 || true
  if [ -n "$${code_server_previous_config:-}" ] && [ -f "$code_server_previous_config" ]; then
    install -o dsh -g dsh -m 0600 "$code_server_previous_config" /home/dsh/.config/code-server/config.yaml || true
  fi
  if [ -n "$${code_server_previous_link:-}" ]; then
    code_server_restore_link="$(mktemp /usr/local/bin/.code-server.restore.XXXXXX)"
    rm -f "$code_server_restore_link"
    ln -s "$code_server_previous_link" "$code_server_restore_link"
    mv -Tf "$code_server_restore_link" /usr/local/bin/code-server || true
  fi
  if [ -n "$${code_server_old_prefix:-}" ] && [ -d "$code_server_old_prefix" ]; then
    rm -rf "$code_server_prefix" || true
    mv "$code_server_old_prefix" "$code_server_prefix" || true
  fi
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl start code-server.service >/dev/null 2>&1 || true
}

case "$(uname -m)" in
  x86_64)
    node_arch="linux-x64"
    ;;
  aarch64)
    node_arch="linux-arm64"
    ;;
  *)
    echo "unsupported architecture: $(uname -m)" >&2
    false
    ;;
esac

pkgs_missing=()
for pkg in ca-certificates curl xz-utils nginx apache2-utils bubblewrap git build-essential python3; do
  dpkg-query -W -f='$${Status}' "$pkg" 2>/dev/null | grep -q "ok installed" || pkgs_missing+=("$pkg")
done
if [ "$${#pkgs_missing[@]}" -gt 0 ]; then
  retry 5 apt-get update
  retry 5 apt-get install -y --no-install-recommends "$${pkgs_missing[@]}"
fi

sys_uid_max="$(awk '$1 == "SYS_UID_MAX" { value = $2 } END { print value }' /etc/login.defs)"
case "$sys_uid_max" in
  ''|*[!0-9]*) sys_uid_max=999 ;;
esac
sys_gid_max="$(awk '$1 == "SYS_GID_MAX" { value = $2 } END { print value }' /etc/login.defs)"
case "$sys_gid_max" in
  ''|*[!0-9]*) sys_gid_max=999 ;;
esac

if getent group dsh >/dev/null; then
  dsh_gid="$(getent group dsh | cut -d: -f3)"
  if ! [[ "$dsh_gid" =~ ^[0-9]+$ ]] || [ "$dsh_gid" -eq 0 ] || [ "$dsh_gid" -gt "$sys_gid_max" ]; then
    echo "unsafe existing dsh group: expected non-root system GID <= $${sys_gid_max}" >&2
    false
  fi
elif id -u dsh >/dev/null 2>&1; then
  echo "unsafe existing dsh user: required primary group dsh does not exist" >&2
  false
else
  groupadd --system dsh
fi

if ! id -u dsh >/dev/null 2>&1; then
  useradd --system --gid dsh --home-dir /home/dsh --create-home --shell /bin/bash dsh
else
  IFS=: read -r _ _ dsh_uid _ _ dsh_home dsh_shell < <(getent passwd dsh)
  dsh_primary_group="$(id -gn dsh)"
  if ! [[ "$dsh_uid" =~ ^[0-9]+$ ]] || \
    [ "$dsh_uid" -eq 0 ] || \
    [ "$dsh_uid" -gt "$sys_uid_max" ] || \
    [ "$dsh_primary_group" != "dsh" ] || \
    [ "$dsh_home" != "/home/dsh" ] || \
    [ "$dsh_shell" != "/bin/bash" ] || \
    id -nG dsh | tr ' ' '\n' | grep -Eq '^(sudo|admin|wheel)$'; then
    echo "unsafe existing dsh user: expected non-root system UID <= $${sys_uid_max}, primary group dsh, home /home/dsh, shell /bin/bash, and no privileged groups" >&2
    false
  fi
fi
passwd --lock dsh >/dev/null
install -d -o dsh -g dsh -m 0700 /home/dsh/.dsh /home/dsh/.npm
install -d -o dsh -g dsh -m 0750 /home/dsh/workspace

work_dir="$(mktemp -d)"
trap 'rm -rf "$work_dir"' EXIT
changed=false
code_server_changed=false
code_server_old_prefix=""
code_server_previous_link=""
code_server_previous_config=""

skill_installer="$work_dir/deployment-environment-skill.py"
skill_candidate="$work_dir/deployment-environment.SKILL.md"
cat > "$skill_installer" <<'DEPLOYMENT_ENVIRONMENT_INSTALLER'
${deployment_environment_skill_installer}
DEPLOYMENT_ENVIRONMENT_INSTALLER
cat > "$skill_candidate" <<'DEPLOYMENT_ENVIRONMENT_SKILL'
${deployment_environment_skill}
DEPLOYMENT_ENVIRONMENT_SKILL
python3 "$skill_installer" --skill-file "$skill_candidate"

node_prefix="/opt/node-v${node_version}"
node_version_file="$node_prefix/VERSION"
if [ ! -x "$node_prefix/bin/node" ] || \
  ! runuser -u dsh -- test -x "$node_prefix/bin/node" || \
  [ ! -f "$node_version_file" ] || \
  [ "$(cat "$node_version_file")" != "${node_version}" ]; then
  archive="node-v${node_version}-$${node_arch}.tar.xz"
  node_url="https://nodejs.org/dist/v${node_version}"
  retry 5 curl --fail --location --output "$work_dir/$archive" "$node_url/$archive"
  retry 5 curl --fail --location --output "$work_dir/SHASUMS256.txt" "$node_url/SHASUMS256.txt"
  awk -v archive="$archive" '$2 == archive { print $1 "  " $2 }' "$work_dir/SHASUMS256.txt" > "$work_dir/SHASUMS256.txt.exact"
  test -s "$work_dir/SHASUMS256.txt.exact"
  (cd "$work_dir" && sha256sum -c SHASUMS256.txt.exact)

  rm -rf "$node_prefix.new"
  mkdir "$node_prefix.new"
  tar --no-same-owner -xJf "$work_dir/$archive" --strip-components=1 -C "$node_prefix.new"
  printf '%s\n' '${node_version}' > "$node_prefix.new/VERSION"
  chmod -R u=rwX,go=rX "$node_prefix.new"
  if [ -d "$node_prefix" ]; then
    rm -rf "$node_prefix.old"
    mv "$node_prefix" "$node_prefix.old"
  fi
  mv "$node_prefix.new" "$node_prefix"
  rm -rf "$node_prefix.old"
  changed=true
fi
for executable in node npm npx; do
  ln -sfn "$node_prefix/bin/$executable" "/usr/local/bin/$executable"
done

case "$(uname -m)" in
  x86_64)
    code_server_archive="code-server-${code_server_version}-linux-amd64.tar.gz"
    code_server_sha256="a38d26f4cb81f768feddff79e2937fd3f39c83d3da8be3da7225e1087e62e4ed"
    ;;
  aarch64)
    code_server_archive="code-server-${code_server_version}-linux-arm64.tar.gz"
    code_server_sha256="ade569a677d1c04ee66ef153382b7e15bf261f955407663c7ddc6b87f9ee29fc"
    ;;
esac
code_server_prefix="/opt/code-server-${code_server_version}"
code_server_binary="$code_server_prefix/bin/code-server"
if [ ! -x "$code_server_binary" ]; then
  code_server_url="https://github.com/coder/code-server/releases/download/v${code_server_version}/$${code_server_archive}"
  code_server_archive_path="$work_dir/$code_server_archive"
  retry 5 curl --fail --location --output "$code_server_archive_path" "$code_server_url"
  printf '%s  %s\n' "$code_server_sha256" "$code_server_archive_path" | sha256sum -c -
  code_server_extract="$work_dir/code-server.new"
  rm -rf "$code_server_extract"
  mkdir "$code_server_extract"
  tar --no-same-owner -xzf "$code_server_archive_path" --strip-components=1 -C "$code_server_extract"
  test -x "$code_server_extract/bin/code-server"
  if [ -e "$code_server_prefix" ]; then
    code_server_old_prefix="$code_server_prefix.old"
    rm -rf "$code_server_old_prefix"
    mv "$code_server_prefix" "$code_server_old_prefix"
  fi
  if ! mv "$code_server_extract" "$code_server_prefix"; then
    if [ -e "$code_server_prefix.old" ]; then mv "$code_server_prefix.old" "$code_server_prefix"; fi
    false
  fi
  chmod -R u=rwX,go=rX "$code_server_prefix"
  code_server_changed=true
fi
code_server_link_target="$(readlink /usr/local/bin/code-server 2>/dev/null || true)"
code_server_previous_link="$code_server_link_target"
if [ "$code_server_link_target" != "$code_server_binary" ]; then
  code_server_link_tmp="$(mktemp /usr/local/bin/.code-server.XXXXXX)"
  rm -f "$code_server_link_tmp"
  ln -s "$code_server_binary" "$code_server_link_tmp"
  mv -Tf "$code_server_link_tmp" /usr/local/bin/code-server
  code_server_changed=true
fi

code_server_config_dir=/home/dsh/.config/code-server
install -d -o dsh -g dsh -m 0700 /home/dsh/.config "$code_server_config_dir"
chown dsh:dsh /home/dsh/.config "$code_server_config_dir"
chmod 0700 /home/dsh/.config "$code_server_config_dir"
code_server_config_tmp="$work_dir/code-server-config.yaml"
code_server_password_decoded="$(printf '%s' '${code_server_password_base64}' | base64 --decode)"
cat > "$code_server_config_tmp" <<CODE_SERVER_CONFIG
bind-addr: 127.0.0.1:${code_server_port}
auth: password
password: '$code_server_password_decoded'
cert: false
CODE_SERVER_CONFIG
unset code_server_password_decoded
code_server_config_dest="$code_server_config_dir/config.yaml"
if [ -f "$code_server_config_dest" ]; then
  code_server_previous_config="$work_dir/code-server-config.previous"
  cp -a "$code_server_config_dest" "$code_server_previous_config"
fi
if [ ! -f "$code_server_config_dest" ] || ! cmp -s "$code_server_config_tmp" "$code_server_config_dest" || [ "$(stat -c '%a' "$code_server_config_dest" 2>/dev/null || true)" != 600 ]; then
  code_server_config_candidate="$code_server_config_dir/.config.yaml.XXXXXX"
  code_server_config_candidate="$(mktemp "$code_server_config_candidate")"
  install -o dsh -g dsh -m 0600 "$code_server_config_tmp" "$code_server_config_candidate"
  mv -f "$code_server_config_candidate" "$code_server_config_dest"
  code_server_changed=true
fi

code_server_unit_tmp="$work_dir/code-server.service"
cat > "$code_server_unit_tmp" <<'CODE_SERVER_UNIT'
[Unit]
Description=code-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
Environment=HOME=/home/dsh
Environment=DSH_HOME=/home/dsh/.dsh
Environment=PATH=/opt/code-server-${code_server_version}/bin:/opt/node-v${node_version}/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/dsh/workspace
ExecStart=/usr/local/bin/code-server --config /home/dsh/.config/code-server/config.yaml
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
CODE_SERVER_UNIT
if [ ! -f /etc/systemd/system/code-server.service ] || ! cmp -s "$code_server_unit_tmp" /etc/systemd/system/code-server.service; then
  install -o root -g root -m 0644 "$code_server_unit_tmp" /etc/systemd/system/code-server.service
  code_server_changed=true
fi

# Resolve and install the complete dependency tree into the dsh-owned npm cache.
dsh_cache_version_file=/home/dsh/.dsh/CACHED_VERSION
if [ ! -f "$dsh_cache_version_file" ] || [ "$(cat "$dsh_cache_version_file")" != "${dsh_version}" ]; then
  retry 5 runuser -u dsh -- env HOME=/home/dsh npm_config_cache=/home/dsh/.npm \
    /bin/bash -c 'cd /home/dsh/workspace && exec /usr/local/bin/npm exec --yes --package="@deepseek-ai/dsh@${dsh_version}" -- dsh --version'
  printf '%s\n' '${dsh_version}' > "$dsh_cache_version_file"
  chown dsh:dsh "$dsh_cache_version_file"
  chmod 0600 "$dsh_cache_version_file"
  changed=true
fi

unit_tmp="$work_dir/deepseek-harness.service"
cat > "$unit_tmp" <<'DSH_UNIT'
[Unit]
Description=DeepSeek Harness web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
Environment=HOME=/home/dsh
Environment=DSH_HOME=/home/dsh/.dsh
Environment=PATH=/opt/node-v${node_version}/bin:/usr/local/bin:/usr/bin:/bin
Environment=npm_config_cache=/home/dsh/.npm
WorkingDirectory=/home/dsh/workspace
ExecStart=/usr/local/bin/npx --offline --yes @deepseek-ai/dsh@${dsh_version} web --port ${dsh_port} --trusted-host ${public_authority}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
DSH_UNIT

if [ ! -f /etc/systemd/system/deepseek-harness.service ] || ! cmp -s "$unit_tmp" /etc/systemd/system/deepseek-harness.service; then
  install -o root -g root -m 0644 "$unit_tmp" /etc/systemd/system/deepseek-harness.service
  changed=true
fi

auth_tmp="$work_dir/deepseek-harness.htpasswd"
web_username="${web_username}"
if [ -f /etc/nginx/deepseek-harness.htpasswd ] && \
  printf '%s' '${web_password_base64}' | base64 --decode | \
    htpasswd -vbi /etc/nginx/deepseek-harness.htpasswd "$web_username" >/dev/null 2>&1; then
  cp /etc/nginx/deepseek-harness.htpasswd "$auth_tmp"
else
  printf '%s' '${web_password_base64}' | base64 --decode | htpasswd -ni "$web_username" > "$auth_tmp"
fi

nginx_tmp="$work_dir/deepseek-harness.conf"
cat > "$nginx_tmp" <<'NGINX_CONFIG'
map_hash_bucket_size 512;

map $http_origin $dsh_origin_allowed {
    default 0;
    "" 1;
    "https://${public_authority}" 1;
}

map $http_sec_fetch_site $dsh_fetch_site_allowed {
    default 1;
    "cross-site" 0;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

server {
    listen 0.0.0.0:${proxy_port};
    server_name _;

    location / {
        if ($dsh_origin_allowed = 0) {
            return 403;
        }
        if ($dsh_fetch_site_allowed = 0) {
            return 403;
        }

        auth_basic "DeepSeek Harness";
        auth_basic_user_file /etc/nginx/deepseek-harness.htpasswd;
        proxy_pass http://127.0.0.1:${dsh_port};
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:${dsh_port};
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Origin "http://127.0.0.1:${dsh_port}";
        proxy_set_header Sec-Fetch-Site "same-origin";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

server {
    listen 0.0.0.0:${code_server_proxy_port};
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:${code_server_port};
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Host ${code_server_public_authority};
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Origin "https://${code_server_public_authority}";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
NGINX_CONFIG

nginx_backup_dir="$work_dir/nginx-backup"
mkdir "$nginx_backup_dir"
nginx_transaction_helper="$work_dir/nginx-transaction.sh"
cat > "$nginx_transaction_helper" <<'NGINX_TRANSACTION_HELPER'
${nginx_transaction_helper}
NGINX_TRANSACTION_HELPER
source "$nginx_transaction_helper"
nginx_auth_dest=/etc/nginx/deepseek-harness.htpasswd
nginx_config_dest=/etc/nginx/sites-available/deepseek-harness
nginx_enabled_dest=/etc/nginx/sites-enabled/deepseek-harness

if ! commit_nginx_candidate; then
  echo "Nginx candidate failed and was rolled back" >&2
  false
fi

if ! systemctl is-enabled --quiet deepseek-harness.service; then
  systemctl enable deepseek-harness.service
fi

if ! systemctl is-enabled --quiet code-server.service; then
  systemctl enable code-server.service
fi

if [ "$changed" = true ] || ! systemctl is-active --quiet deepseek-harness.service; then
  systemctl daemon-reload
  systemctl restart deepseek-harness.service
fi

if [ "$code_server_changed" = true ] || ! systemctl is-active --quiet code-server.service; then
  systemctl daemon-reload
  systemctl restart code-server.service
fi


for _ in $(seq 1 60); do
  if systemctl is-active --quiet deepseek-harness.service; then
    dsh_http_code="$(curl --silent --output /dev/null --write-out '%%{http_code}' --max-time 2 http://127.0.0.1:${dsh_port}/ || true)"
    nginx_http_code="$(curl --silent --output /dev/null --write-out '%%{http_code}' --max-time 2 http://127.0.0.1:${proxy_port}/ || true)"
    code_server_http_code="$(curl --silent --output /dev/null --write-out '%%{http_code}' --max-time 2 http://127.0.0.1:${code_server_port}/ || true)"
    code_server_proxy_http_code="$(curl --silent --output /dev/null --write-out '%%{http_code}' --max-time 2 http://127.0.0.1:${code_server_proxy_port}/ || true)"
    case "$dsh_http_code" in
      2??)
        case "$code_server_http_code:$code_server_proxy_http_code" in
          401:401|401:302|302:401|302:302)
            if [ "$nginx_http_code" = "401" ]; then
              [ -z "$code_server_old_prefix" ] || rm -rf "$code_server_old_prefix"
              exit 0
            fi
            ;;
        esac
        ;;
    esac
  fi
  sleep 1
done

echo "DeepSeek Harness failed service, loopback, or Nginx authentication health checks" >&2
false
