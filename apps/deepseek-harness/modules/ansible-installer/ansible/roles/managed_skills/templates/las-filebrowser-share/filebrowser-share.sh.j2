#!/usr/bin/env bash
set -euo pipefail
umask 077

script_dir="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
export LAS_FILEBROWSER_API_BASE='http://127.0.0.1:{{ filebrowser_port }}'
export LAS_FILEBROWSER_SOURCE='{{ filebrowser_source_name }}'
export LAS_FILEBROWSER_TOKEN_FILE='{{ filebrowser_token_path }}'
exec python3 "$script_dir/filebrowser-share.py" "$@"
