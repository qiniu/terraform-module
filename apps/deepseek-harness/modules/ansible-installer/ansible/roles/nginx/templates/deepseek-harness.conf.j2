map_hash_bucket_size 512;

map $http_origin $dsh_origin_allowed {
    default 0;
    "" 1;
    "https://{{ dsh_web_public_authority }}" 1;
}

# 跨站实例 output 链接属于浏览器发起的文档导航，需要继续进入
# Basic Auth 以返回 401；其他跨站请求仍在认证前拒绝，避免放宽 API 边界。
map "$http_sec_fetch_site:$http_sec_fetch_mode:$http_sec_fetch_dest:$request_method" $dsh_fetch_site_allowed {
    default 1;
    "cross-site:navigate:document:GET" 1;
    ~^cross-site: 0;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

server {
    listen 0.0.0.0:{{ dsh_web_proxy_port }};
    server_name _;

    location = /manifest.webmanifest {
        auth_basic off;
        proxy_pass http://127.0.0.1:{{ dsh_port }};
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:{{ dsh_port }};
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Origin "http://127.0.0.1:{{ dsh_port }}";
        proxy_set_header Sec-Fetch-Site "same-origin";
    }

    # 未配对设备的心跳会正常返回业务态 401，不能再被外层 Basic Auth
    # 转换为浏览器密码提示；接口本身只刷新配对设备状态，不暴露受保护数据。
    # 当安装了插件 @linxin666/dsh-web-ui-all 时，会导致401请求频繁弹出auth对话框
    location = /api/pair/heartbeat {
        if ($dsh_origin_allowed = 0) { return 403; }
        if ($dsh_fetch_site_allowed = 0) { return 403; }

        auth_basic off;
        proxy_pass http://127.0.0.1:{{ dsh_port }};
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Host 127.0.0.1:{{ dsh_port }};
        proxy_set_header Origin "http://127.0.0.1:{{ dsh_port }}";
        proxy_set_header Sec-Fetch-Site "same-origin";
        proxy_intercept_errors on;
        error_page 401 =204 @dsh_pair_heartbeat_unpaired;
    }

    location @dsh_pair_heartbeat_unpaired {
        return 204;
    }

    # dshmarket 只接受直接来自回环地址且不带代理转发链的重启请求。
    # 公网访问仍受本部署的 Basic Auth 和上述同源校验保护。
    location = /dsh-market/restart {
        if ($dsh_origin_allowed = 0) { return 403; }
        if ($dsh_fetch_site_allowed = 0) { return 403; }

        auth_basic "DeepSeek Harness";
        auth_basic_user_file /etc/nginx/deepseek-harness.htpasswd;
        proxy_pass http://127.0.0.1:{{ dsh_port }};
        proxy_http_version 1.1;
        proxy_set_header Host {{ dsh_web_public_authority }};
        proxy_set_header Origin "https://{{ dsh_web_public_authority }}";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
    }

    # Basic Auth 必须在带上游错误拦截的 location 之外完成，否则 Nginx
    # 自己返回的 401 会被误当成 DSH 的 401，从而绕过密码校验。
    location = / {
        if ($dsh_origin_allowed = 0) { return 403; }
        if ($dsh_fetch_site_allowed = 0) { return 403; }

        auth_basic "DeepSeek Harness";
        auth_basic_user_file /etc/nginx/deepseek-harness.htpasswd;
        access_log off;
        try_files /__las_dsh_root_proxy_never_exists__ @dsh_root_proxy;
    }

    location @dsh_root_proxy {
        access_log off;
        proxy_pass http://127.0.0.1:{{ dsh_port }};
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:{{ dsh_port }};
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Origin "http://127.0.0.1:{{ dsh_port }}";
        proxy_set_header Sec-Fetch-Site "same-origin";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # 该公网入口由 Basic Auth 保护，登录用户即实例管理员。使用 DSH
        # 原生 transport 契约开放 Host Settings，不再改写版本相关的 JS bundle。
        proxy_set_header Accept-Encoding "";
        sub_filter '</head>' '<script>globalThis.__DSH_TRANSPORT__=Object.assign({},globalThis.__DSH_TRANSPORT__,{ownsHost:true});</script></head>';

        proxy_intercept_errors on;
        error_page 401 = @dsh_auth_bootstrap;
    }

    location @dsh_auth_bootstrap {
        if ($arg_token != "") { return 401; }

        access_log off;
        rewrite ^ {{ dsh_auth_bootstrap_route }} break;
        proxy_pass http://127.0.0.1:{{ dsh_port }};
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Host 127.0.0.1:{{ dsh_port }};
        proxy_set_header Origin "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        include /etc/deepseek-harness/nginx-dsh-auth-bootstrap-secret.conf;
    }

    location = {{ dsh_auth_bootstrap_route }} {
        return 404;
    }

    location / {
        if ($dsh_origin_allowed = 0) { return 403; }
        if ($dsh_fetch_site_allowed = 0) { return 403; }

        auth_basic "DeepSeek Harness";
        auth_basic_user_file /etc/nginx/deepseek-harness.htpasswd;
        proxy_pass http://127.0.0.1:{{ dsh_port }};
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:{{ dsh_port }};
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Origin "http://127.0.0.1:{{ dsh_port }}";
        proxy_set_header Sec-Fetch-Site "same-origin";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # 同时覆盖直接访问由 SPA fallback 返回的 HTML 路径。
        proxy_set_header Accept-Encoding "";
        sub_filter '</head>' '<script>globalThis.__DSH_TRANSPORT__=Object.assign({},globalThis.__DSH_TRANSPORT__,{ownsHost:true});</script></head>';
    }
}

server {
    listen 0.0.0.0:{{ static_preview_proxy_port }};
    server_name _;
    root {{ static_preview_dir }};
    autoindex off;
    index index.html;
    disable_symlinks on;

    location ~ (^|/)\. {
        return 404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

{% if enable_code_server | bool %}
server {
    listen 0.0.0.0:{{ code_server_proxy_port }};
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:{{ code_server_port }};
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Host {{ code_server_public_authority }};
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Origin "https://{{ code_server_public_authority }}";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
{% endif %}

{% if enable_filebrowser | bool %}
server {
    listen 0.0.0.0:{{ filebrowser_proxy_port }};
    server_name _;
    client_max_body_size 128m;

    location / {
        proxy_pass http://127.0.0.1:{{ filebrowser_port }};
        proxy_http_version 1.1;
        proxy_set_header Host {{ filebrowser_public_authority }};
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
{% endif %}
